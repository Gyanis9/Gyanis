#---------------------------------------------------------------------------
# Doxyfile 配置文件 — 适用于 Doxygen 生成 C++ 项目文档（中文）
#---------------------------------------------------------------------------

# 输出文档语言
OUTPUT_LANGUAGE        = Chinese

# 项目名称
PROJECT_NAME           = "Gyanis"

# 项目简要描述
PROJECT_BRIEF          = "Gyanis 项目自动化文档生成"

# 源代码文件夹（多个目录以空格分隔）
INPUT                  = include src

# 是否递归搜索子目录
RECURSIVE              = YES

# 要扫描的文件类型（可根据项目实际扩展）
FILE_PATTERNS          = *.h *.hpp *.cpp *.cc *.cxx *.c

# 是否提取所有类和文件
EXTRACT_ALL            = YES

# 文档输出目录
OUTPUT_DIRECTORY       = docs

# 是否生成 HTML 文档
GENERATE_HTML          = YES
HTML_OUTPUT            = html

# 是否生成 LaTeX（PDF）文档
GENERATE_LATEX         = NO

# 是否在文档中显示源码
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES

# 显示类继承关系图等（需安装 dot 支持）
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_DIAGRAMS         = YES
DOT_FONTNAME           = "Microsoft YaHei"

# 输入的编码，UTF-8 支持中文
INPUT_ENCODING         = UTF-8

# 提取注释样式（/// ///< /** */ /*! */ 等）
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES

# 是否文档注释中支持 @brief, @param, @return 等
MULTILINE_CPP_IS_BRIEF = YES

# 是否提取私有成员的注释
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# 构建索引
GENERATE_INDEX         = YES
GENERATE_TREEVIEW      = YES

# 跳过无文档成员（如需全部显示，设为 NO）
HIDE_UNDOC_MEMBERS     = NO
